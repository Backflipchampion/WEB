<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pixel Insel SVG</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #7ec8e3;
      font-family: Arial, sans-serif;
    }

    .island {
      width: 320px;
      image-rendering: pixelated;
    }

    .island:hover {
      transform: scale(1.05);
      transition: transform 0.2s ease;
    }
  </style>
</head>
<body>

  <svg
    class="island"
    viewBox="0 0 16 16"
    xmlns="http://www.w3.org/2000/svg"
    shape-rendering="crispEdges"
    aria-label="Pixel-Art-Insel"
  >
    <!-- wasser -->
    <rect x="0" y="0" width="16" height="16" fill="#7ec8e3"/>

    <!-- sand -->
    <rect x="4" y="3" width="8" height="1" fill="#f4d35e"/>
    <rect x="3" y="4" width="10" height="1" fill="#f4d35e"/>
    <rect x="2" y="5" width="12" height="1" fill="#f4d35e"/>
    <rect x="2" y="6" width="12" height="1" fill="#f4d35e"/>
    <rect x="3" y="7" width="10" height="1" fill="#f4d35e"/>
    <rect x="4" y="8" width="8" height="1" fill="#f4d35e"/>

    <!-- gras -->
    <rect x="5" y="4" width="6" height="1" fill="#6ecb63"/>
    <rect x="4" y="5" width="8" height="1" fill="#6ecb63"/>
    <rect x="4" y="6" width="8" height="1" fill="#6ecb63"/>
    <rect x="5" y="7" width="6" height="1" fill="#6ecb63"/>

    <!-- palmenstamm -->
    <rect x="7" y="4" width="1" height="3" fill="#8b5a2b"/>

    <!-- palmenblätter -->
    <rect x="6" y="3" width="1" height="1" fill="#2f8f46"/>
    <rect x="7" y="2" width="1" height="1" fill="#2f8f46"/>
    <rect x="8" y="3" width="1" height="1" fill="#2f8f46"/>
    <rect x="6" y="4" width="1" height="1" fill="#2f8f46"/>
    <rect x="8" y="4" width="1" height="1" fill="#2f8f46"/>
  </svg>

</body>
</html>
